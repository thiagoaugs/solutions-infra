# PRODUÇÃO — o sistema que as barracas usam de verdade. Projeto GCP próprio (isolado da homologação).
# Sem segredos aqui: os segredos ficam no Secret Manager do projeto.
# Publicado só por tag de versão (v1.2.3) no GitHub. Ver docs/deploy-gcp.md.

AMBIENTE="producao"
PROJETO="troque-pelo-id-do-projeto-de-producao"
REGIAO="southamerica-east1"

# Domínio público (QR Code, telas). Vazio = domínio padrão do Firebase: https://<PROJETO>.web.app
DOMINIO=""
# E-mail do primeiro usuário ADMIN do sistema (a senha inicial é gerada no setup e trocada no 1º login)
ADMIN_EMAIL="voce@exemplo.com.br"

# Banco (Cloud SQL): backups diários por 14 dias e proteção contra exclusão
INSTANCIA_SQL="praia-db"
SQL_TIER="db-g1-small"        # db-f1-micro (mais barato) | db-g1-small | db-custom-1-3840 ...
SQL_BACKUPS="sim"
# Limite de instâncias da API (cada uma atende 80 requisições ao mesmo tempo). Ver "Escalar" na doc.
MAX_API=4
# Barraca de exemplo na 1ª subida: nunca em produção
DADOS_EXEMPLO="false"

# Rede privada (o banco não tem IP público; Cloud Run acessa por Direct VPC egress)
REDE="praia-vpc"
SUBREDE="praia-subnet"
SUBREDE_FAIXA="10.10.0.0/24"

# GitHub: só workflows rodando numa TAG de versão (v1.2.3) podem publicar aqui (Workload Identity Federation)
GITHUB_REF_CONDICAO="assertion.ref.startsWith('refs/tags/v')"

# ---------------------------------------------------------------- despertador (hibernação)
# Horário em que a infraestrutura fica LIGADA (fuso abaixo). Fora dele: banco parado e serviços sem
# instância mínima. Dê folga em relação ao horário das barracas (8h–18h).
HORA_ACORDAR=7
HORA_HIBERNAR=20
# Dias da semana em que liga automaticamente: 1=segunda ... 7=domingo
DIAS="1234567"
FUSO="America/Sao_Paulo"
# Serviços que ficam com instância mínima durante o horário (evita espera no 1º acesso)
SERVICOS_SEMPRE_PRONTOS="praia-keycloak,praia-api"
MIN_INSTANCIAS=1
# Quando acordado manualmente fora do horário, por quantas horas fica ligado (padrão do atalho)
HORAS_EXTRAS_PADRAO=3

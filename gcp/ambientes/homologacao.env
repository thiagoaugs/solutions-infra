# HOMOLOGAÇÃO — cópia da produção para testar antes de publicar, no menor custo possível.
# Mesma arquitetura e mesmos scripts da produção, em OUTRO projeto GCP (dados, senhas e permissões separados).
# Publicado automaticamente a cada push na main. As telas mostram a faixa "AMBIENTE DE TESTES".
#
# Diferenças para economizar (o resto é igual à produção):
#   - banco menor (db-f1-micro) e sem backups;
#   - fica HIBERNADO o tempo todo: só liga quando alguém acorda para testar (DIAS="0") e volta a dormir sozinho;
#   - API limitada a 1 instância.
# Parado, custa basicamente o disco do banco (10 GB). Ver estimativa em docs/deploy-gcp.md.

AMBIENTE="homologacao"
PROJETO="swell-homologacao"
REGIAO="southamerica-east1"

DOMINIO=""
ADMIN_EMAIL="thiagoaugs@gmail.com"

INSTANCIA_SQL="praia-db"
SQL_TIER="db-f1-micro"
SQL_BACKUPS="nao"
MAX_API=1
# Sobe com a "Barraca do Sol" de exemplo (cardápio e mesas) para testar sem cadastrar tudo.
# Nunca copie dados da produção para cá (nomes de clientes, pagamentos).
DADOS_EXEMPLO="true"

REDE="praia-vpc"
SUBREDE="praia-subnet"
SUBREDE_FAIXA="10.10.0.0/24"

# GitHub: só workflows rodando na branch main podem publicar aqui
GITHUB_REF_CONDICAO="assertion.ref == 'refs/heads/main'"

# ---------------------------------------------------------------- despertador (hibernação)
HORA_ACORDAR=7
HORA_HIBERNAR=20
# "0" = nunca liga sozinho: só sob demanda (despertador-cli.sh homologacao acordar 2)
DIAS="0"
FUSO="America/Sao_Paulo"
SERVICOS_SEMPRE_PRONTOS="praia-keycloak,praia-api"
MIN_INSTANCIAS=1
# Acordado para testar, fica ligado por 2h e hiberna sozinho
HORAS_EXTRAS_PADRAO=2
